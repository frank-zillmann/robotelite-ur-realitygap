# ── OS / editor cruft ───────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
*~

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ── Secrets / scratch (root 'tmp' holds an API key — never commit) ────────────
tmp
.env
*.env
*.key

# ── Agent / tooling config — not part of the student repo ─────────────────────
ai/
.claude/
**/.claude/

# ── docs/: ship the built .pptx + tiers doc, not the builders or its assets ───
docs/build_deck.py
docs/build_tiers.py
docs/assets/
docs/~$*.pptx
docs/~$*.docx
docs/*.tmp

# ── case 2: recorded runs are regenerated via collect_data.py, don't commit ───
# them (manifest.csv and legacy_unclamped/ are kept -- small, and useful as-is)
case 2/data/*.csv
!case 2/data/manifest.csv
case 2/data/heldout/
case 2/scripts/_generated/
