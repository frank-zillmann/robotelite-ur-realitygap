# T09_fast_r2 baseline: retimed by rl_optimize, geometry unchanged.
#
# Each movej is the same straight line the recording drew; only its speed
# and acceleration differ, and each sleep is the original scaled. Run it
# with send.py --script, or load it on the pendant.

movej([-0.599994, -1.799994, 0.900003, -1.570800, -1.570800, 0.000000], a=2.0039, v=1.0000)
sleep(0.8080)
movej([0.400000, -1.000000, 1.000000, -1.570800, -1.570800, 0.000000], a=2.0039, v=1.0000)
sleep(0.8080)
movej([-0.300000, -1.600000, 1.000000, -1.570800, -1.570800, 0.000000], a=2.0039, v=1.0000)
sleep(0.8080)
movej([0.000000, -1.200000, 1.200000, -1.570800, -1.570800, 0.000000], a=2.0039, v=0.8857)
sleep(0.9840)
