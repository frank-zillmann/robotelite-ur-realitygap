# Wrist sweep - one cycle: the three wrist joints move, the arm stays put.
#
# Coverage motion for data collection. Base, shoulder and elbow are pinned at one
# extended pose (TCP ~1.0 m out, ~103 Nm gravity load on the shoulder) while
# wrist1/2/3 sweep 1.1..4.4 rad. The existing runs barely turn the wrists
# (`analysis.py` reports near-zero range on joints 3..5), so the gap model has no
# data on the small joints at all; they are also the ones whose ring is easiest
# to excite because their inertia is tiny next to the arm they hang off.
#
# UNITS: movej `v` is rad/s and `a` is rad/s^2. The wrists clamp at ~3.14 rad/s
# and the big joints at ~2.09 rad/s; keep vel <= 2.0 so nothing saturates.
#
#     python collect.py --scripts scripts/wrist_sweep.script
#
# Plain assignments (no `global`): send.py wraps this in a repeat loop, and
# URScript does not allow a `global` declaration inside a loop.

vel = 1.05
acc = 1.4

# base    shoulder  elbow    wrist1   wrist2   wrist3
W1 = [  0.500,  -0.400,  -0.500,  -0.670,  -1.570,   0.000]
W2 = [  0.500,  -0.400,  -0.500,  -2.400,   1.300,   2.200]
W3 = [  0.500,  -0.400,  -0.500,   0.400,  -0.300,  -2.200]
W4 = [  0.500,  -0.400,  -0.500,  -1.500,   1.570,   1.100]
W5 = [  0.500,  -0.400,  -0.500,  -0.200,  -1.200,  -1.100]

write_output_float_register(1, vel)
write_output_float_register(2, acc)
movej(W1, a=acc, v=vel)
sleep(0.6)
movej(W2, a=acc, v=vel)
sleep(0.6)
movej(W3, a=acc, v=vel)
sleep(0.6)
movej(W4, a=acc, v=vel)
sleep(0.6)
movej(W5, a=acc, v=vel)
sleep(0.6)
