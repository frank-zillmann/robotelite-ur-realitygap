# T04 vertical_swing - one cycle: over the top and back.
#
# The arm starts laid down flat (shoulder 0, elbow straight), and the shoulder
# (joint 1) rotates from 0 to -180 degrees and back, swinging the arm up and over
# through vertical in a vertical plane. Optimize it with --joint 1.
#
# Edit vel and acc below (rad/s, rad/s^2 -- movej's native units), then run it
# with send.py (--loop N repeats the cycle). Plain assignments (no `global`):
# send.py wraps this in a repeat loop, and URScript does not allow a `global`
# declaration inside a loop.

# UNITS: movej `v` is rad/s and `a` is rad/s^2. The controller clamps anything
# above the joint limit (~3.14 rad/s / 180 deg/s, uniform across every joint on
# the UR5e), so a big number here means every run records at the same maximum
# speed. 1.05 / 1.4 are the URScript movej defaults.
vel = 1.05
acc = 1.4

# Two poses [rad], arm laid down (elbow straight); the shoulder swings 0 to -180.
POSE_FLAT_A = [0.0,  0.0,    0.0, -1.5708, -1.5708, 0.0]  # shoulder 0 deg
POSE_FLAT_B = [0.0, -3.1416, 0.0, -1.5708, -1.5708, 0.0]  # shoulder -180 deg

write_output_float_register(1, vel)
write_output_float_register(2, acc)
movej(POSE_FLAT_A, a=acc, v=vel)
sleep(0.8)
movej(POSE_FLAT_B, a=acc, v=vel)
sleep(0.8)
